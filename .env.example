# Local development values for docker-compose.yml. Copy to .env and adjust.
SB_ADMIN_DATABASE_URL=postgresql://secondbrain_admin:dev_admin_password@localhost:55432/secondbrain
SB_APP_DATABASE_URL=postgresql://secondbrain_app:dev_app_password@localhost:55432/secondbrain
SB_REDIS_URL=redis://localhost:56379/0

# Model provider: "stub" (offline, for tests) or "litellm" (company proxy).
SB_MODEL_PROVIDER=stub
SB_LITELLM_BASE_URL=
SB_LITELLM_API_KEY=
SB_LLM_MODEL=
SB_EMBEDDING_MODEL=

# Must match the embedding model's output size. Changing it later means
# recreating the memories table and re-embedding.
SB_EMBEDDING_DIM=1024

# Short-term memory lifetime in seconds.
SB_SHORT_TERM_TTL=86400

# Protects /admin endpoints. Leave empty to disable the admin API.
SB_ADMIN_TOKEN=
# Lets the chat screen pick a user. Turn off outside demos.
SB_DEMO_MODE=true
