# Local development values for docker-compose.yml. Copy to .env and adjust.
SB_ADMIN_DATABASE_URL=postgresql://secondbrain_admin:dev_admin_password@localhost:55432/secondbrain
# Optional. Leave it out to use the admin login for the API too: the API then switches
# to the secondbrain_app role on every connection, so row-level security still applies.
SB_APP_DATABASE_URL=postgresql://secondbrain_app:dev_app_password@localhost:55432/secondbrain
SB_REDIS_URL=redis://localhost:56379/0
SB_FALKORDB_URL=redis://localhost:56380

# Model provider: "stub" (offline, for tests) or "litellm" (company proxy).
SB_MODEL_PROVIDER=stub
SB_LITELLM_BASE_URL=
SB_LITELLM_API_KEY=
SB_LLM_MODEL=
SB_EMBEDDING_MODEL=

# Must match the embedding model's output size. Changing it later means
# recreating the memories table and re-embedding.
SB_EMBEDDING_DIM=1024

# Short-term memory lifetime in seconds.
SB_SHORT_TERM_TTL=86400

# Protects /admin endpoints. Leave empty to disable the admin API.
SB_ADMIN_TOKEN=
# Lets the chat screen pick a user. Turn off outside demos.
SB_DEMO_MODE=true

# Real business data (docs/INTEGRATION.md). Production MQTT is MQTTS on 8883;
# the docker compose dev broker is plain MQTT on 51883 (SB_MQTT_TLS=false).
SB_MQTT_HOST=localhost
SB_MQTT_PORT=8883
SB_MQTT_TLS=true
SB_MQTT_CA_FILE=
SB_MQTT_USERNAME=
SB_MQTT_PASSWORD=
SB_MQTT_CLIENT_ID=secondbrain-ingest
SB_MQTT_SHARE_GROUP=
# Recalculate a company's forecasts and signals at most this often after its data changes.
SB_INGEST_REFRESH_MINUTES=10
SB_INGEST_AUTO_REFRESH=true

# Live notifications to people (second broker, see docs/LIVE.md). Empty host = off.
# Generate both secrets with: python -c "import secrets; print(secrets.token_hex(32))"
SB_LIVE_HOST=localhost
SB_LIVE_PORT=51884
SB_LIVE_WS_URL=ws://localhost:59001
SB_LIVE_SECRET=
SB_LIVE_PUBLISHER_PASSWORD=
